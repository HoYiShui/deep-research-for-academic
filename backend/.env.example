# Copy this file to .env and fill in real values. Never commit .env.
# .env / .env.* / *.swp are already gitignored.

# ---- LLM (deepseek via Anthropic-compatible API) ----
ANTHROPIC_API_KEY=your-deepseek-api-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-flash

# ---- Web search (Bocha) ----
BOCHA_API_KEY=your-bocha-api-key

# ---- PostgreSQL (app connection + compose infra creds) ----
# Compose's postgres service reads POSTGRES_*; the app reads DATABASE_URL.
# Host-side development connects to Compose's default PostgreSQL port 5432.
# The production backend container overrides this with postgres:5432.
DATABASE_URL=postgresql://deepresearch:deepresearch@localhost:5432/deepresearch
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=deepresearch
POSTGRES_DB=deepresearch

# ---- Milvus (vector store) ----
# Host-side development connects to the Standalone service in docker-compose.yml.
# The production backend container overrides this with http://milvus:19530.
MILVUS_URI=http://localhost:19530
# legacy fallback, used only when MILVUS_URI is unset
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---- MinIO (object storage for PDFs + chunk text) ----
# App reads MINIO_*; compose's minio service reads MINIO_ROOT_* (same creds).
# Host-side development connects to Compose's default MinIO API port 9000.
# The production backend container overrides this with minio:9000.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=deepresearch
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- BGE model weights (local dir overrides HF hub download) ----
# Leave as the HF hub name to download on first use, or set to a local
# sentence-transformers weights dir.
BGE_M3_MODEL_PATH=BAAI/bge-m3
BGE_RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3

# ---- HF endpoint (China mirror) ----
HF_ENDPOINT=https://hf-mirror.com

# ---- Auth ----
# Local development deliberately bypasses login so the TUI can validate the
# research workflow. Production compose overrides this to true.
DR4A_AUTH_REQUIRED=false
# JWT signing remains configured for the production authentication profile.
JWT_SECRET=change-me
