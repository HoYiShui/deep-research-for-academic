# Copy this file to .env and fill in real values. Never commit .env.

# ---- LLM (deepseek via Anthropic-compatible API) ----
ANTHROPIC_API_KEY=your-deepseek-api-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ---- Web search (Bocha) ----
BOCHA_API_KEY=your-bocha-api-key

# ---- PostgreSQL ----
DATABASE_URL=postgresql://user:password@localhost:5432/deepresearch

# ---- Milvus (vector store) ----
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---- MinIO (object storage for PDFs + chunk text) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=deepresearch

# ---- Auth (JWT signing secret) ----
JWT_SECRET=change-me
