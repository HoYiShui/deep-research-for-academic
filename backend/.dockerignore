# Secrets — never bake into the image
.env
.env.*
!.env.example

# VCS + editors (incl. .env.swp / *~ backups)
.git
.gitignore
.DS_Store
*.swp
*~

# Python caches / venvs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.uv/

# Build + test artifacts not needed at runtime
*.egg-info/
build/
dist/
tests/
scripts/
